{
  "name": "blacktecch-sms-hub-server",
  "version": "2.0.0",
  "private": true,
  "description": "Central auth, manual monthly subscriptions, recipient-group sync and Socket.IO forwarding endpoint for BlackTecch SMS Hub",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "create-account": "node scripts/create_account.js",
    "extend-subscription": "node scripts/extend_subscription.js",
    "freeze-now": "node -e \"require('./cron/freezeExpired').freezeExpiredAccounts().then(()=>process.exit(0))\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.12.0",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.5"
  }
}
