# Copy to .env and fill in real values before running the server.
# Never commit the real .env file.

PORT=3000

# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://sms_hub:change_me@localhost:5432/sms_hub

# Long, random strings - e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-before-deploying
ADMIN_KEY=change-me-admin-key
